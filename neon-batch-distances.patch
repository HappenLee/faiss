+template <bool is_inner_product>
+static inline float32x4_t fvec_op_neon(float32x4_t x, float32x4_t y) {
+    if constexpr (is_inner_product) {
+        return vmulq_f32(x, y);
+    } else {
+        const float32x4_t diff = vsubq_f32(x, y);
+        return vmulq_f32(diff, diff);
+    }
+}
+
+template <bool is_inner_product>
+static inline float32x4_t fvec_op_neon_merge(
+        float32x4_t sum,
+        float32x4_t x,
+        float32x4_t y) {
+    if constexpr (is_inner_product) {
+        return vfmaq_f32(sum, x, y);
+    } else {
+        const float32x4_t diff = vsubq_f32(x, y);
+        return vfmaq_f32(sum, diff, diff);
+    }
+}
+
+// For D=2 and D=4, each lane holds one candidate. For D=8, accumulate
+// the two halves of each candidate, then reduce four candidates together.
+template <bool is_inner_product, size_t D>
+static size_t fvec_op_ny_neon_lowdim(
+        float* dis,
+        const float* x,
+        const float* y,
+        size_t ny) {
+    const size_t ny_simd = ny - (ny & 3);
+    if (ny_simd == 0) {
+        return 0;
+    }
+
+    if constexpr (D == 2) {
+        const float32x4_t x0 = vdupq_n_f32(x[0]);
+        const float32x4_t x1 = vdupq_n_f32(x[1]);
+        for (size_t i = 0; i < ny_simd; i += 4) {
+            const float32x4x2_t yv = vld2q_f32(y + i * D);
+            const auto sum = fvec_op_neon<is_inner_product>(x0, yv.val[0]);
+            vst1q_f32(
+                    dis + i,
+                    fvec_op_neon_merge<is_inner_product>(sum, x1, yv.val[1]));
+        }
+    } else if constexpr (D == 4) {
+        const float32x4_t x0 = vdupq_n_f32(x[0]);
+        const float32x4_t x1 = vdupq_n_f32(x[1]);
+        const float32x4_t x2 = vdupq_n_f32(x[2]);
+        const float32x4_t x3 = vdupq_n_f32(x[3]);
+        for (size_t i = 0; i < ny_simd; i += 4) {
+            const float32x4x4_t yv = vld4q_f32(y + i * D);
+            auto sum = fvec_op_neon<is_inner_product>(x0, yv.val[0]);
+            sum = fvec_op_neon_merge<is_inner_product>(sum, x1, yv.val[1]);
+            sum = fvec_op_neon_merge<is_inner_product>(sum, x2, yv.val[2]);
+            vst1q_f32(
+                    dis + i,
+                    fvec_op_neon_merge<is_inner_product>(sum, x3, yv.val[3]));
+        }
+    } else {
+        static_assert(D == 8);
+        const float32x4_t x0 = vld1q_f32(x);
+        const float32x4_t x1 = vld1q_f32(x + 4);
+        const auto partial_distance = [&](const float* row) {
+            const auto sum = fvec_op_neon<is_inner_product>(x0, vld1q_f32(row));
+            return fvec_op_neon_merge<is_inner_product>(
+                    sum, x1, vld1q_f32(row + 4));
+        };
+        for (size_t i = 0; i < ny_simd; i += 4) {
+            const float* row = y + i * D;
+            const auto s0 = partial_distance(row);
+            const auto s1 = partial_distance(row + D);
+            const auto s2 = partial_distance(row + 2 * D);
+            const auto s3 = partial_distance(row + 3 * D);
+            vst1q_f32(
+                    dis + i,
+                    vpaddq_f32(vpaddq_f32(s0, s1), vpaddq_f32(s2, s3)));
+        }
+    }
+    return ny_simd;
+}
+
+template <bool is_inner_product>
+static inline size_t fvec_op_ny_neon(
+        float* dis,
+        const float* x,
+        const float* y,
+        size_t d,
+        size_t ny) {
+    switch (d) {
+        case 2:
+            return fvec_op_ny_neon_lowdim<is_inner_product, 2>(dis, x, y, ny);
+        case 4:
+            return fvec_op_ny_neon_lowdim<is_inner_product, 4>(dis, x, y, ny);
+        case 8:
+            return fvec_op_ny_neon_lowdim<is_inner_product, 8>(dis, x, y, ny);
+        default:
+            return 0;
+    }
+}

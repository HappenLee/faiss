 namespace faiss {
 
+namespace {
+
+// Each lane holds one candidate for d=2 and d=4. For d=8, accumulate
+// across the two halves of each candidate, then reduce four candidates.
+template <bool IsL2>
+inline float32x4_t distance_term(float32x4_t x, float32x4_t y) {
+    if constexpr (IsL2) {
+        const float32x4_t delta = vsubq_f32(x, y);
+        return vmulq_f32(delta, delta);
+    } else {
+        return vmulq_f32(x, y);
+    }
+}
+
+template <bool IsL2>
+inline float32x4_t add_distance_term(
+        float32x4_t sum,
+        float32x4_t x,
+        float32x4_t y) {
+    if constexpr (IsL2) {
+        const float32x4_t delta = vsubq_f32(x, y);
+        return vfmaq_f32(sum, delta, delta);
+    } else {
+        return vfmaq_f32(sum, x, y);
+    }
+}
+
+template <bool IsL2, size_t D>
+size_t batch_distances_neon(
+        float* dis,
+        const float* x,
+        const float* y,
+        size_t ny) {
+    const size_t end = ny & ~size_t{3};
+    if (end == 0) {
+        return 0;
+    }
+
+    if constexpr (D == 2) {
+        const float32x4_t x0 = vdupq_n_f32(x[0]);
+        const float32x4_t x1 = vdupq_n_f32(x[1]);
+        for (size_t i = 0; i < end; i += 4) {
+            const auto rows = vld2q_f32(y + i * D);
+            const auto sum = distance_term<IsL2>(x0, rows.val[0]);
+            vst1q_f32(dis + i, add_distance_term<IsL2>(sum, x1, rows.val[1]));
+        }
+    } else if constexpr (D == 4) {
+        const float32x4_t x0 = vdupq_n_f32(x[0]);
+        const float32x4_t x1 = vdupq_n_f32(x[1]);
+        const float32x4_t x2 = vdupq_n_f32(x[2]);
+        const float32x4_t x3 = vdupq_n_f32(x[3]);
+        for (size_t i = 0; i < end; i += 4) {
+            const auto rows = vld4q_f32(y + i * D);
+            auto sum = distance_term<IsL2>(x0, rows.val[0]);
+            sum = add_distance_term<IsL2>(sum, x1, rows.val[1]);
+            sum = add_distance_term<IsL2>(sum, x2, rows.val[2]);
+            vst1q_f32(dis + i, add_distance_term<IsL2>(sum, x3, rows.val[3]));
+        }
+    } else {
+        static_assert(D == 8);
+        const float32x4_t x0 = vld1q_f32(x);
+        const float32x4_t x1 = vld1q_f32(x + 4);
+        const auto partial_distance = [&](const float* row) {
+            const auto sum = distance_term<IsL2>(x0, vld1q_f32(row));
+            return add_distance_term<IsL2>(sum, x1, vld1q_f32(row + 4));
+        };
+        for (size_t i = 0; i < end; i += 4) {
+            const float* row = y + i * D;
+            const auto s0 = partial_distance(row);
+            const auto s1 = partial_distance(row + D);
+            const auto s2 = partial_distance(row + 2 * D);
+            const auto s3 = partial_distance(row + 3 * D);
+            vst1q_f32(
+                    dis + i,
+                    vpaddq_f32(vpaddq_f32(s0, s1), vpaddq_f32(s2, s3)));
+        }
+    }
+    return end;
+}
+
+template <bool IsL2>
+void batch_distances(
+        float* dis,
+        const float* x,
+        const float* y,
+        size_t d,
+        size_t ny) {
+    if (ny == 0) {
+        return;
+    }
+    size_t processed = 0;
+    switch (d) {
+        case 2:
+            processed = batch_distances_neon<IsL2, 2>(dis, x, y, ny);
+            break;
+        case 4:
+            processed = batch_distances_neon<IsL2, 4>(dis, x, y, ny);
+            break;
+        case 8:
+            processed = batch_distances_neon<IsL2, 8>(dis, x, y, ny);
+            break;
+    }
+    if (processed == ny) {
+        return;
+    }
+    if constexpr (IsL2) {
+        fvec_L2sqr_ny<SIMDLevel::NONE>(
+                dis + processed, x, y + processed * d, d, ny - processed);
+    } else {
+        fvec_inner_products_ny<SIMDLevel::NONE>(
+                dis + processed, x, y + processed * d, d, ny - processed);
+    }
+}
+
